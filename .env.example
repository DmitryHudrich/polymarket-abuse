# Copy to .env. Both binaries load .env automatically.
# Env overrides YAML but is overridden by CLI flags.

# --- detector ---
# DETECTOR_CONFIG=config/detector.yaml
# DETECTOR_BIND_ADDR=0.0.0.0:8080
# DETECTOR_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# DETECTOR_GAMMA_URL=https://gamma-api.polymarket.com
# DETECTOR_WATCH_FILE=watchlist.json
# DETECTOR_SEARCH_LIMIT=8
# DETECTOR_AUTO_DISCOVER=true
# DETECTOR_DISCOVER_INTERVAL_SECS=300
# DETECTOR_DISCOVER_MIN_VOLUME=0
# DETECTOR_FEE_BPS=0
# DETECTOR_SLIPPAGE_BPS=0
# DETECTOR_GAS_COST=0
# DETECTOR_MAX_CAPITAL=1000
# DETECTOR_MIN_PROFIT=0
# DETECTOR_MIN_EDGE=0
# DETECTOR_LOG_LEVEL=info

# --- analytics (ClickHouse) ---
# Compose already points the detector at the clickhouse service; set these only
# to change the credentials or to use a store you host elsewhere. Leave
# DETECTOR_CLICKHOUSE_URL empty to turn analytics off entirely.
# DETECTOR_CLICKHOUSE_URL=http://clickhouse:8123
# DETECTOR_CLICKHOUSE_DB=arb
# DETECTOR_CLICKHOUSE_USER=arb
# DETECTOR_CLICKHOUSE_PASSWORD=change-me
# DETECTOR_ANALYTICS_SAMPLE_MS=500
# DETECTOR_ANALYTICS_BOOK_SAMPLE_SECS=300
# DETECTOR_ANALYTICS_TRADE_WINDOW_SECS=300
# DETECTOR_ANALYTICS_DEPTH_LEVELS=5
# DETECTOR_ANALYTICS_BATCH_ROWS=500
# DETECTOR_ANALYTICS_FLUSH_SECS=2
# DETECTOR_ANALYTICS_QUEUE_CAP=50000
# DETECTOR_ANALYTICS_TTL_DAYS=90

# --- telegram-bot ---
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
TELEGRAM_CHAT_ID=123456789
# TELEGRAM_BACKEND_URL=http://localhost:8080
# TELEGRAM_POLL_INTERVAL_SECS=10
# TELEGRAM_ALERT_MIN_EDGE=0.01
# TELEGRAM_ALERT_MIN_PROFIT=1.0
# TELEGRAM_ONLY_PROFITABLE=true
# TELEGRAM_REALERT_IMPROVEMENT=0.01
# TELEGRAM_SETTINGS_FILE=bot-settings.json
# TELEGRAM_ARCHIVE_FILE=bot-archive.json
# TELEGRAM_TZ_OFFSET_HOURS=0
# TELEGRAM_LOG_LEVEL=info
